      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM n8n_chat_histories\nWHERE session_id = $1\n  AND id < (\n    SELECT COALESCE(MIN(id), 0) FROM (\n      SELECT id FROM n8n_chat_histories\n      WHERE session_id = $1 AND message->>'type' = 'human'\n      ORDER BY id DESC LIMIT 6\n    ) recent\n  );",
        "options": {
          "queryReplacement": "={{ $json.sessionId }}"
        }
      },
      "onError": "continueRegularOutput",
      "alwaysOutputData": true,
